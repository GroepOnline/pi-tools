{
  "name": "@groeponline/pi-tools",
  "public": true,
  "version": "0.10.5",
  "description": "High-speed local search for Pi: fuzzy file discovery, SIMD content search, frecency ranking, and FFF-backed @ completion.",
  "type": "module",
  "license": "MIT",
  "author": "GroepOnline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/pi-tools.git",
    "directory": "packages/pi-tools"
  },
  "homepage": "https://github.com/GroepOnline/pi-tools/tree/main/packages/pi-tools#readme",
  "bugs": {
    "url": "https://github.com/GroepOnline/pi-tools/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "fff",
    "search",
    "grep",
    "fuzzy-search",
    "ai-agent",
    "local-first",
    "groeponline",
    "pi-coding-agent",
    "coding-agent",
    "file-search",
    "content-search",
    "autocomplete",
    "developer-tools"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/GroepOnline/pi-tools/main/assets/logo-orange.png"
  },
  "files": [
    "src",
    "pi-tools.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "verify:pi-package": "node --test scripts/verify-pi-package-contract-runtime.test.mjs && node scripts/verify-pi-package-contract.mjs",
    "prepublishOnly": "npm run verify:pi-package"
  },
  "dependencies": {
    "@groeponline/fff-bun": "*",
    "@groeponline/fff-node": "*",
    "@sinclair/typebox": "^0.34.52"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
